// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model User {
    id            String             @id(map: "user_pkey")
    name          String
    email         String
    emailVerified Boolean
    isFrozen      Boolean            @default(false)
    image         String?
    role          pg.enum(UserRole) @default("USER")
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    accounts      Account[]
    cartItems     CartItem[]
    orders        Order[]
    sessions      Session[]

    @@index([email], map: "user_email_key", unique: true)
    @@map("user")
  }

  model Account {
    id                    String              @id(map: "account_pkey")
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  TimestampString(3)?
    refreshTokenExpiresAt TimestampString(3)?
    scope                 String?
    password              String?
    createdAt             TimestampString(3)  @default(now())
    updatedAt             TimestampString(3)
    user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "account_userId_fkey", index: false)

    @@map("account")
  }

  model Product {
    id              String             @id(map: "product_pkey")
    name            String
    slug            String
    description     String?
    price           Numeric(10, 2)
    category        pg.enum(Category)
    isActive        Boolean            @default(true)
    sku             String
    createdAt       TimestampString(3) @default(now())
    updatedAt       TimestampString(3)
    productVariants ProductVariant[]

    @@index([sku], map: "product_sku_key", unique: true)
    @@index([slug], map: "product_slug_key", unique: true)
    @@map("product")
  }

  model ProductVariant {
    id         String             @id(map: "product_variant_pkey")
    productId  String
    name       String
    size       String
    color      String
    stock      Int                @default(0)
    imageUrl   String
    createdAt  TimestampString(3) @default(now())
    updatedAt  TimestampString(3)
    cartItems  CartItem[]
    orderItems OrderItem[]
    product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "product_variant_productId_fkey", index: "product_variant_productId_size_color_key")

    @@index([productId, size, color], map: "product_variant_productId_size_color_key", unique: true)
    @@map("product_variant")
  }

  model CartItem {
    userId           String
    productVariantId String
    quantity         Int                @default(1)
    createdAt        TimestampString(3) @default(now())
    updatedAt        TimestampString(3)
    productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "cart_item_productVariantId_fkey", index: false)
    user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "cart_item_userId_fkey", index: "cart_item_pkey")

    @@id([userId, productVariantId], map: "cart_item_pkey")
    @@map("cart_item")
  }

  model Order {
    id            String                 @id(map: "order_pkey")
    userId        String
    totalAmount   Numeric(10, 2)
    status        pg.enum(OrderStatus)   @default("PENDING")
    paymentMethod pg.enum(PaymentMethod) @default("CASH_ON_DELIVERY")
    address       String
    contactNumber String                 @map("ContactNumber")
    createdAt     TimestampString(3)     @default(now())
    updatedAt     TimestampString(3)
    orderItems    OrderItem[]
    user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "order_userId_fkey", index: false)

    @@map("order")
  }

  model OrderItem {
    id               String             @id(map: "order_item_pkey")
    orderId          String
    productVariantId String
    size             String
    color            String
    quantity         Int
    unitPrice        Numeric(10, 2)
    createdAt        TimestampString(3) @default(now())
    updatedAt        TimestampString(3)
    order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "order_item_orderId_fkey", index: false)
    productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "order_item_productVariantId_fkey", index: false)

    @@map("order_item")
  }

  model Session {
    id        String             @id(map: "session_pkey")
    expiresAt TimestampString(3)
    token     String
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)
    ipAddress String?
    userAgent String?
    userId    String
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "session_userId_fkey", index: false)

    @@index([token], map: "session_token_key", unique: true)
    @@map("session")
  }

  model Verification {
    id         String              @id(map: "verification_pkey")
    identifier String
    value      String
    expiresAt  TimestampString(3)
    createdAt  TimestampString(3)?
    updatedAt  TimestampString(3)?

    @@map("verification")
  }

  native_enum Category {
    MEN = "MEN"
    WOMEN = "WOMEN"
    KIDS = "KIDS"
    TEENS = "TEENS"
    ACCESSORIES = "ACCESSORIES"
  }

  native_enum OrderStatus {
    PENDING = "PENDING"
    PROCESSING = "PROCESSING"
    SHIPPED = "SHIPPED"
    DELIVERED = "DELIVERED"
    CANCELLED = "CANCELLED"
  }

  native_enum PaymentMethod {
    CREDIT_CARD = "CREDIT_CARD"
    PAYPAL = "PAYPAL"
    BANK_TRANSFER = "BANK_TRANSFER"
    CASH_ON_DELIVERY = "CASH_ON_DELIVERY"
  }

  native_enum UserRole {
    USER = "USER"
    ADMIN = "ADMIN"
  }
}
